<Window x:Class="Fuseo.App.Views.ExportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:p="clr-namespace:Fuseo.App.Properties"
        Title="{x:Static p:Strings.ExportTitle}"
        Width="820" Height="940" MinWidth="560" MinHeight="600"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <!-- 書き出しシート（絶対条件: 保存前の確認 UI を外さない）。プレビューは BurnIn の結果画像そのもの。 -->
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="{x:Static p:Strings.ExportTitle}" FontSize="20" FontWeight="SemiBold"/>
            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                <TextBlock Text="{x:Static p:Strings.ExportFormatLabel}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                <RadioButton Content="PDF" IsChecked="{Binding IsPdf}" Margin="0,0,16,0" GroupName="fmt"
                             AutomationProperties.AutomationId="export.format.pdf"/>
                <RadioButton Content="JPEG" IsChecked="{Binding IsJpeg}" Margin="0,0,16,0" GroupName="fmt"
                             AutomationProperties.AutomationId="export.format.jpeg"/>
                <RadioButton Content="PNG" IsChecked="{Binding IsPng}" GroupName="fmt"
                             AutomationProperties.AutomationId="export.format.png"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,10,0,0"
                        Visibility="{Binding HasMultipleDocuments, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="{x:Static p:Strings.ExportModeLabel}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                <RadioButton Content="{x:Static p:Strings.ExportCombine}" IsChecked="{Binding IsCombine}" Margin="0,0,16,0" GroupName="mode"
                             IsEnabled="{Binding IsNotCompleted}" AutomationProperties.AutomationId="export.combine"/>
                <RadioButton Content="{x:Static p:Strings.ExportSeparate}" IsChecked="{Binding IsSeparate}" GroupName="mode"
                             IsEnabled="{Binding IsNotCompleted}" AutomationProperties.AutomationId="export.separate"/>
            </StackPanel>
            <TextBlock Text="{x:Static p:Strings.ExportSeparateModeNote}" TextWrapping="Wrap" FontSize="12" Margin="0,8,0,0"
                       Foreground="#555" Visibility="{Binding ShowSeparateModeNote, Converter={StaticResource BoolToVis}}"
                       AutomationProperties.AutomationId="export.separateNote"/>
            <TextBlock Text="{x:Static p:Strings.ExportPdfNote}" TextWrapping="Wrap" FontSize="12" Margin="0,8,0,0"
                       Foreground="#555" Visibility="{Binding ShowPdfNote, Converter={StaticResource BoolToVis}}"/>
            <TextBlock Text="{x:Static p:Strings.ExportSeparateFilesNote}" TextWrapping="Wrap" FontSize="12" Margin="0,8,0,0"
                       Foreground="#555" Visibility="{Binding ShowSeparateFilesNote, Converter={StaticResource BoolToVis}}"/>

            <!-- 提出用の設定（0.4.0）: 透かし・ファイルの大きさの上限・PDF のパスワード。中身と文言は Mac 版と同じ。 -->
            <GroupBox Header="{x:Static p:Strings.ExportExtrasHeading}" Margin="0,12,0,0" Padding="8,6"
                      IsEnabled="{Binding IsNotCompleted}">
                <StackPanel>
                    <CheckBox Content="{x:Static p:Strings.ExportWatermark}" IsChecked="{Binding WatermarkEnabled}"
                              AutomationProperties.AutomationId="export.watermark"/>
                    <Grid Margin="20,6,0,0" Visibility="{Binding ShowWatermarkOptions, Converter={StaticResource BoolToVis}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{x:Static p:Strings.ExportWatermarkTextLabel}" FontSize="12"/>
                            <DockPanel Margin="0,2,0,0">
                                <Button DockPanel.Dock="Right" Content="{x:Static p:Strings.ExportWatermarkAddDate}" Command="{Binding AddDateCommand}"
                                        Padding="8,2" Margin="6,0,0,0" AutomationProperties.AutomationId="export.watermarkDate"/>
                                <TextBox Text="{Binding WatermarkText, UpdateSourceTrigger=PropertyChanged}"
                                         AutomationProperties.AutomationId="export.watermarkText"/>
                            </DockPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                <TextBlock Text="{x:Static p:Strings.ExportWatermarkLayoutLabel}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <RadioButton Content="{x:Static p:Strings.ExportWatermarkTiled}" IsChecked="{Binding IsWatermarkTiled}" GroupName="wm"
                                             Margin="0,0,12,0" AutomationProperties.AutomationId="export.watermarkTiled"/>
                                <RadioButton Content="{x:Static p:Strings.ExportWatermarkDiagonal}" IsChecked="{Binding IsWatermarkDiagonal}" GroupName="wm"
                                             AutomationProperties.AutomationId="export.watermarkDiagonal"/>
                            </StackPanel>
                            <DockPanel Margin="0,6,0,0">
                                <TextBlock DockPanel.Dock="Left" Text="{x:Static p:Strings.ExportWatermarkOpacity}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <Slider Minimum="{Binding WatermarkMinOpacity, Mode=OneTime}" Maximum="{Binding WatermarkMaxOpacity, Mode=OneTime}"
                                        Value="{Binding WatermarkOpacity}" AutomationProperties.AutomationId="export.watermarkOpacity"/>
                            </DockPanel>
                            <TextBlock Text="{x:Static p:Strings.ExportWatermarkEmpty}" FontSize="12" Foreground="#555" Margin="0,4,0,0"
                                       Visibility="{Binding ShowWatermarkEmpty, Converter={StaticResource BoolToVis}}"/>
                            <TextBlock Text="{x:Static p:Strings.ExportWatermarkNote}" FontSize="12" Foreground="#555" TextWrapping="Wrap" Margin="0,4,0,0"
                                       Visibility="{Binding HasWatermarkPreview, Converter={StaticResource BoolToVis}}"/>
                        </StackPanel>
                        <Border Grid.Column="1" Margin="12,0,0,0" BorderBrush="#AAA" BorderThickness="1" VerticalAlignment="Top"
                                Visibility="{Binding HasWatermarkPreview, Converter={StaticResource BoolToVis}}">
                            <Image Source="{Binding WatermarkPreview}" MaxHeight="140" MaxWidth="200" Stretch="Uniform"
                                   RenderOptions.BitmapScalingMode="HighQuality" AutomationProperties.AutomationId="export.watermarkPreview"/>
                        </Border>
                    </Grid>

                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0" Visibility="{Binding ShowSizeLimit, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="{x:Static p:Strings.ExportSizeLimitLabel}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <ComboBox ItemsSource="{Binding SizeLimitOptions}" SelectedItem="{Binding SelectedSizeLimit}" DisplayMemberPath="Label"
                                  MinWidth="140" AutomationProperties.AutomationId="export.sizeLimit"/>
                    </StackPanel>
                    <TextBlock Text="{x:Static p:Strings.ExportSizeLimitNote}" FontSize="12" Foreground="#555" TextWrapping="Wrap" Margin="0,4,0,0"
                               Visibility="{Binding ShowSizeLimitNote, Converter={StaticResource BoolToVis}}"/>

                    <CheckBox Content="{x:Static p:Strings.ExportPassword}" IsChecked="{Binding PasswordEnabled}" Margin="0,10,0,0"
                              Visibility="{Binding ShowPasswordOptions, Converter={StaticResource BoolToVis}}"
                              AutomationProperties.AutomationId="export.password"/>
                    <StackPanel Margin="20,6,0,0" Visibility="{Binding ShowPasswordFields, Converter={StaticResource BoolToVis}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{x:Static p:Strings.ExportPasswordLabel}" VerticalAlignment="Center" Width="90"/>
                            <PasswordBox x:Name="PasswordField" Width="220" MaxLength="64" PasswordChanged="OnPasswordChanged"
                                         AutomationProperties.AutomationId="export.passwordField"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <TextBlock Text="{x:Static p:Strings.ExportPasswordConfirmLabel}" VerticalAlignment="Center" Width="90"/>
                            <PasswordBox x:Name="PasswordConfirmField" Width="220" MaxLength="64" PasswordChanged="OnPasswordChanged"
                                         AutomationProperties.AutomationId="export.passwordConfirm"/>
                        </StackPanel>
                        <TextBlock Text="{Binding PasswordMessage}" Foreground="#C62828" TextWrapping="Wrap" FontSize="12" Margin="0,4,0,0"
                                   Visibility="{Binding HasPasswordMessage, Converter={StaticResource BoolToVis}}"
                                   AutomationProperties.AutomationId="export.passwordMessage"/>
                        <TextBlock Text="{x:Static p:Strings.ExportPasswordNote}" FontSize="12" Foreground="#555" TextWrapping="Wrap" Margin="0,4,0,0"/>
                    </StackPanel>
                </StackPanel>
            </GroupBox>
        </StackPanel>

        <StackPanel Grid.Row="1" Margin="0,16,0,6">
            <TextBlock Text="{x:Static p:Strings.ExportPreviewHeading}" FontWeight="SemiBold"/>
            <TextBlock Text="{x:Static p:Strings.ExportPreviewNote}" TextWrapping="Wrap" FontSize="12" Foreground="#555"/>
            <TextBlock Text="{Binding SummaryText}" Margin="0,6,0,0" AutomationProperties.AutomationId="export.summary"/>
            <!-- 文字入れ（v0.3）: 書いた量の確認と、枠からはみ出している文字（切り取らずにそのまま書き出す）。 -->
            <TextBlock Text="{Binding TextSummaryText}" Margin="0,2,0,0"
                       Visibility="{Binding HasTexts, Converter={StaticResource BoolToVis}}"
                       AutomationProperties.AutomationId="export.textSummary"/>
            <TextBlock Text="{Binding TextOverflowText}" Foreground="#C62828" TextWrapping="Wrap" Margin="0,2,0,0"
                       Visibility="{Binding HasOverflowingTexts, Converter={StaticResource BoolToVis}}"
                       AutomationProperties.AutomationId="export.textOverflow"/>
        </StackPanel>

        <Border Grid.Row="2" BorderBrush="#CCC" BorderThickness="1" Background="#E8E8E8">
            <Grid>
                <ItemsControl ItemsSource="{Binding Previews}"
                              VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                              ScrollViewer.CanContentScroll="True"
                              AutomationProperties.AutomationId="export.previews">
                    <ItemsControl.Template>
                        <ControlTemplate TargetType="ItemsControl">
                            <ScrollViewer CanContentScroll="True" VerticalScrollBarVisibility="Auto">
                                <ItemsPresenter/>
                            </ScrollViewer>
                        </ControlTemplate>
                    </ItemsControl.Template>
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <VirtualizingStackPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="12">
                                <TextBlock Text="{Binding Title}" Margin="0,0,0,4" FontSize="12"/>
                                <Border Background="White" HorizontalAlignment="Center" BorderBrush="#AAA" BorderThickness="1">
                                    <Image Source="{Binding Image}" Stretch="Uniform" MaxHeight="560"
                                           RenderOptions.BitmapScalingMode="HighQuality"/>
                                </Border>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="{x:Static p:Strings.ExportPreparing}" HorizontalAlignment="Center" VerticalAlignment="Center"
                           AutomationProperties.AutomationId="export.preparing"
                           Visibility="{Binding IsPreparing, Converter={StaticResource BoolToVis}}"/>
            </Grid>
        </Border>

        <StackPanel Grid.Row="3" Margin="0,12,0,0">
            <ItemsControl ItemsSource="{Binding Warnings}" Visibility="{Binding HasWarnings, Converter={StaticResource BoolToVis}}"
                          AutomationProperties.AutomationId="export.warnings">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <DockPanel Margin="0,0,0,4">
                            <TextBlock DockPanel.Dock="Left" Text="&#xE7BA;" FontFamily="Segoe MDL2 Assets"
                                       Foreground="#E65100" Margin="0,2,6,0"/>
                            <TextBlock Text="{Binding}" TextWrapping="Wrap" FontSize="12"/>
                        </DockPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Text="{x:Static p:Strings.ExportZeroMaskWarning}" Foreground="#C62828" TextWrapping="Wrap" Margin="0,4,0,0"
                       Visibility="{Binding HasZeroMaskPage, Converter={StaticResource BoolToVis}}"
                       AutomationProperties.AutomationId="export.zeroMaskWarning"/>
            <TextBlock Text="{Binding ZeroMaskDocumentsText}" Foreground="#C62828" TextWrapping="Wrap" Margin="0,2,0,0"
                       Visibility="{Binding HasZeroMaskDocuments, Converter={StaticResource BoolToVis}}"
                       AutomationProperties.AutomationId="export.zeroMaskDocuments"/>
            <!-- 「書類ごとに分ける」で保存し終えた（W9-4）。 -->
            <Border Background="#E8F5E9" BorderBrush="#81C784" BorderThickness="1" Padding="10,8" Margin="0,8,0,0"
                    Visibility="{Binding IsCompleted, Converter={StaticResource BoolToVis}}"
                    AutomationProperties.AutomationId="export.completed">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="{x:Static p:Strings.ExportOpenSavedFolder}" Command="{Binding OpenSavedFolderCommand}"
                            Padding="10,3" AutomationProperties.AutomationId="export.openSavedFolder"/>
                    <TextBlock Text="{Binding CompletedText}" VerticalAlignment="Center" FontWeight="SemiBold"
                               AutomationProperties.AutomationId="export.completedText"/>
                </DockPanel>
            </Border>
        </StackPanel>

        <DockPanel Grid.Row="4" Margin="0,16,0,0" LastChildFill="False">
            <TextBlock DockPanel.Dock="Left" Text="{x:Static p:Strings.ExportSaving}" VerticalAlignment="Center"
                       Visibility="{Binding IsSaving, Converter={StaticResource BoolToVis}}"/>
            <Button DockPanel.Dock="Right" Content="{Binding SaveButtonText}" Command="{Binding SaveCommand}"
                    IsDefault="True" MinWidth="120" Padding="12,4" AutomationProperties.AutomationId="export.confirmButton"/>
            <Button DockPanel.Dock="Right" Content="{Binding CancelButtonText}" Command="{Binding CancelCommand}"
                    IsCancel="True" MinWidth="88" Padding="12,4" Margin="0,0,8,0" AutomationProperties.AutomationId="export.cancel"/>
        </DockPanel>
    </Grid>
</Window>
