<Window x:Class="Fuseo.App.Views.PasswordDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:p="clr-namespace:Fuseo.App.Properties"
        Title="{x:Static p:Strings.PasswordTitle}"
        Width="420" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        FocusManager.FocusedElement="{Binding ElementName=PasswordInput}">
    <StackPanel Margin="20">
        <TextBlock x:Name="MessageText" TextWrapping="Wrap" Margin="0,0,0,12" AutomationProperties.AutomationId="password.message"/>
        <PasswordBox x:Name="PasswordInput" Padding="4" AutomationProperties.Name="{x:Static p:Strings.PasswordTitle}"
                     AutomationProperties.AutomationId="password.input"/>
        <TextBlock Text="{x:Static p:Strings.PasswordNote}" TextWrapping="Wrap" Margin="0,10,0,0"
                   Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" FontSize="12"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="{x:Static p:Strings.Ok}" IsDefault="True" MinWidth="88" Margin="0,0,8,0" Click="OnOk"
                    AutomationProperties.AutomationId="password.ok"/>
            <Button Content="{x:Static p:Strings.Cancel}" IsCancel="True" MinWidth="88" AutomationProperties.AutomationId="password.cancel"/>
        </StackPanel>
    </StackPanel>
</Window>
