<Window x:Class="Fuseo.App.Views.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:p="clr-namespace:Fuseo.App.Properties"
        xmlns:s="clr-namespace:Fuseo.App.Services"
        Title="{x:Static p:Strings.AboutTitle}"
        Width="640" Height="680" MinWidth="480" MinHeight="480"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <!-- バージョン情報（W6）。アドレスは選択できる文字列＋コピーだけ（クリックでブラウザを開く処理は入れない＝通信ゼロの方針を形でも守る）。 -->
    <DockPanel Margin="20">
        <StackPanel DockPanel.Dock="Top">
            <TextBlock Text="{x:Static p:Strings.AppTitle}" FontSize="20" FontWeight="SemiBold"/>
            <TextBlock x:Name="VersionText" Margin="0,4,0,0" AutomationProperties.AutomationId="about.version"/>
            <TextBlock Text="{x:Static p:Strings.AboutCopyright}" Margin="0,2,0,0"/>
            <Border Background="#EAF6EC" BorderBrush="#9BD3A6" BorderThickness="1" CornerRadius="4" Padding="10,6" Margin="0,12,0,0">
                <TextBlock Text="{x:Static p:Strings.AboutNoNetwork}" TextWrapping="Wrap" Foreground="#14532D"
                           AutomationProperties.AutomationId="about.noNetwork"/>
            </Border>

            <Grid Margin="0,14,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Grid.Column="0" Text="{x:Static p:Strings.AboutWebsite}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <TextBox Grid.Row="0" Grid.Column="1" Text="{x:Static s:AboutInfo.WebsiteAddress}" IsReadOnly="True"
                         VerticalContentAlignment="Center" Padding="3" AutomationProperties.AutomationId="about.website"
                         AutomationProperties.Name="{x:Static p:Strings.AboutWebsite}"/>
                <Button Grid.Row="0" Grid.Column="2" Content="{x:Static p:Strings.AboutCopy}" Padding="10,2" Margin="6,0,0,0"
                        Tag="{x:Static s:AboutInfo.WebsiteAddress}" Click="OnCopy" AutomationProperties.AutomationId="about.copyWebsite"/>
                <TextBlock Grid.Row="1" Grid.Column="0" Text="{x:Static p:Strings.AboutSourceCode}" VerticalAlignment="Center" Margin="0,6,10,0"/>
                <TextBox Grid.Row="1" Grid.Column="1" Text="{x:Static s:AboutInfo.SourceCodeAddress}" IsReadOnly="True" Margin="0,6,0,0"
                         VerticalContentAlignment="Center" Padding="3" AutomationProperties.AutomationId="about.source"
                         AutomationProperties.Name="{x:Static p:Strings.AboutSourceCode}"/>
                <Button Grid.Row="1" Grid.Column="2" Content="{x:Static p:Strings.AboutCopy}" Padding="10,2" Margin="6,6,0,0"
                        Tag="{x:Static s:AboutInfo.SourceCodeAddress}" Click="OnCopy" AutomationProperties.AutomationId="about.copySource"/>
            </Grid>
            <TextBlock Text="{x:Static p:Strings.AboutUrlNote}" TextWrapping="Wrap" FontSize="11" Foreground="#666" Margin="0,4,0,0"/>
            <TextBlock x:Name="CopiedText" FontSize="11" Foreground="#15803D" Margin="0,2,0,0" AutomationProperties.AutomationId="about.copied"/>
        </StackPanel>

        <DockPanel DockPanel.Dock="Bottom" Margin="0,12,0,0" LastChildFill="False">
            <Button DockPanel.Dock="Right" Content="{x:Static p:Strings.Close}" IsCancel="True" MinWidth="88" Padding="12,4"
                    Click="OnClose" AutomationProperties.AutomationId="about.close"/>
        </DockPanel>

        <TabControl Margin="0,14,0,0">
            <TabItem Header="{x:Static p:Strings.AboutLicenseHeading}">
                <TextBox x:Name="LicenseText" IsReadOnly="True" TextWrapping="Wrap" FontFamily="Consolas" FontSize="12"
                         VerticalScrollBarVisibility="Auto" BorderThickness="0" Padding="6"
                         AutomationProperties.AutomationId="about.license"/>
            </TabItem>
            <TabItem Header="{x:Static p:Strings.AboutThirdPartyHeading}">
                <TextBox x:Name="ThirdPartyText" IsReadOnly="True" TextWrapping="Wrap" FontFamily="Consolas" FontSize="12"
                         VerticalScrollBarVisibility="Auto" BorderThickness="0" Padding="6"
                         AutomationProperties.AutomationId="about.thirdParty"/>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
