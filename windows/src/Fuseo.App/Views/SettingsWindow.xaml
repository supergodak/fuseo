<Window x:Class="Fuseo.App.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:p="clr-namespace:Fuseo.App.Properties"
        Title="{x:Static p:Strings.SettingsTitle}"
        Width="560" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <!-- 設定（W6）: 表示言語／作業の保存場所／すべての作業を削除。通信する項目は持たない。 -->
    <StackPanel Margin="20">
        <TextBlock Text="{x:Static p:Strings.SettingsLanguageLabel}" FontWeight="SemiBold"/>
        <ComboBox ItemsSource="{Binding LanguageOptions}" SelectedItem="{Binding SelectedLanguage}" DisplayMemberPath="DisplayName"
                  IsEnabled="{Binding CanChangeLanguage}" Margin="0,6,0,0" AutomationProperties.AutomationId="settings.language"
                  AutomationProperties.Name="{x:Static p:Strings.SettingsLanguageLabel}"/>
        <TextBlock Text="{x:Static p:Strings.SettingsRestartNote}" TextWrapping="Wrap" FontSize="12" Foreground="#B45309" Margin="0,6,0,0"/>

        <TextBlock Text="{x:Static p:Strings.SettingsStorageHeading}" FontWeight="SemiBold" Margin="0,20,0,0"/>
        <TextBlock Text="{x:Static p:Strings.SettingsStorageNote}" TextWrapping="Wrap" FontSize="12" Foreground="#555" Margin="0,4,0,6"/>
        <DockPanel>
            <Button DockPanel.Dock="Right" Content="{x:Static p:Strings.SettingsOpenFolder}" Command="{Binding OpenFolderCommand}"
                    Padding="10,3" Margin="8,0,0,0" AutomationProperties.AutomationId="settings.openFolder"/>
            <TextBox Text="{Binding StoragePath, Mode=OneWay}" IsReadOnly="True" VerticalContentAlignment="Center" Padding="3"
                     AutomationProperties.AutomationId="settings.storagePath"
                     AutomationProperties.Name="{x:Static p:Strings.SettingsStorageHeading}"/>
        </DockPanel>

        <TextBlock Text="{x:Static p:Strings.SettingsDeleteHeading}" FontWeight="SemiBold" Margin="0,20,0,0"/>
        <TextBlock Text="{x:Static p:Strings.SettingsDeleteAllNote}" TextWrapping="Wrap" FontSize="12" Foreground="#555" Margin="0,4,0,6"/>
        <DockPanel>
            <Button DockPanel.Dock="Left" Content="{x:Static p:Strings.SettingsDeleteAll}" Command="{Binding DeleteAllCommand}"
                    Padding="10,3" AutomationProperties.AutomationId="settings.deleteAll"/>
            <TextBlock Text="{Binding DeleteAllStatus}" TextWrapping="Wrap" FontSize="12" Foreground="#555" VerticalAlignment="Center"
                       Margin="10,0,0,0" AutomationProperties.AutomationId="settings.deleteAllStatus"/>
        </DockPanel>

        <Button Content="{x:Static p:Strings.Close}" IsCancel="True" HorizontalAlignment="Right" MinWidth="88"
                Padding="12,4" Margin="0,24,0,0" Click="OnClose" AutomationProperties.AutomationId="settings.close"/>
    </StackPanel>
</Window>
