<Window x:Class="Fuseo.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:p="clr-namespace:Fuseo.App.Properties"
        xmlns:v="clr-namespace:Fuseo.App.Views"
        xmlns:vm="clr-namespace:Fuseo.App.ViewModels"
        Title="{x:Static p:Strings.AppTitle}" Width="1280" Height="820" MinWidth="1024" MinHeight="700"
        AllowDrop="True" Background="#F3F3F3">
    <Window.InputBindings>
        <KeyBinding Key="O" Modifiers="Control" Command="{Binding OpenFilesCommand}"/>
        <KeyBinding Key="N" Modifiers="Control" Command="{Binding NewDocumentCommand}"/>
        <KeyBinding Key="Z" Modifiers="Control" Command="{Binding UndoCommand}"/>
        <KeyBinding Key="Y" Modifiers="Control" Command="{Binding RedoCommand}"/>
        <KeyBinding Key="Z" Modifiers="Control+Shift" Command="{Binding RedoCommand}"/>
        <KeyBinding Key="Delete" Command="{Binding DeleteSelectionCommand}"/>
        <KeyBinding Key="Back" Command="{Binding DeleteSelectionCommand}"/>
        <KeyBinding Key="E" Modifiers="Control" Command="{Binding ExportCommand}"/>
        <KeyBinding Key="L" Modifiers="Control" Command="{Binding RotateLeftCommand}"/>
        <KeyBinding Key="R" Modifiers="Control" Command="{Binding RotateRightCommand}"/>
        <KeyBinding Key="V" Command="{Binding SetToolCommand}" CommandParameter="{x:Static vm:EditorTool.Select}"/>
        <KeyBinding Key="R" Command="{Binding SetToolCommand}" CommandParameter="{x:Static vm:EditorTool.Rect}"/>
        <KeyBinding Key="B" Command="{Binding SetToolCommand}" CommandParameter="{x:Static vm:EditorTool.Brush}"/>
    </Window.InputBindings>

    <Grid>
    <DockPanel>
        <!-- ツールバー（W6: 最小幅 1024 で日本語・英語とも全ボタンが見えるよう、道具はグループ単位で折り返す）。 -->
        <Border DockPanel.Dock="Top" Background="White" BorderBrush="#DDD" BorderThickness="0,0,0,1" Padding="10,4">
            <DockPanel>
                <!-- 書き出し・設定・バージョン情報は右に固定（折り返しても書き出しボタンは常に右上に見える）。 -->
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top" Margin="8,2,0,2">
                    <Button Content="{x:Static p:Strings.Settings}" Command="{Binding OpenSettingsCommand}" Padding="8,4"
                            ToolTip="{x:Static p:Strings.SettingsTip}" AutomationProperties.AutomationId="main.settings"/>
                    <Button Content="{x:Static p:Strings.About}" Command="{Binding OpenAboutCommand}" Padding="8,4" Margin="4,0,8,0"
                            ToolTip="{x:Static p:Strings.AboutTip}" AutomationProperties.AutomationId="main.about"/>
                    <Button Content="{x:Static p:Strings.ExportButton}" Command="{Binding ExportCommand}"
                            Padding="14,4" FontWeight="SemiBold" AutomationProperties.AutomationId="main.export"/>
                </StackPanel>

                <WrapPanel Orientation="Horizontal" AutomationProperties.AutomationId="main.toolbar">
                    <WrapPanel.Resources>
                        <Style TargetType="StackPanel">
                            <Setter Property="Orientation" Value="Horizontal"/>
                            <Setter Property="Margin" Value="0,2,14,2"/>
                        </Style>
                    </WrapPanel.Resources>
                    <StackPanel>
                        <Button Content="{x:Static p:Strings.NewDocument}" Command="{Binding NewDocumentCommand}"
                                Padding="8,4" Margin="0,0,4,0" ToolTip="{x:Static p:Strings.NewDocumentTip}"
                                AutomationProperties.AutomationId="main.newDocument"/>
                        <Button Content="{x:Static p:Strings.OpenFiles}" Command="{Binding OpenFilesCommand}"
                                Padding="8,4" ToolTip="{x:Static p:Strings.OpenFilesTip}" AutomationProperties.AutomationId="main.openFiles"/>
                        <Button Content="{x:Static p:Strings.OpenFolder}" Command="{Binding OpenFolderCommand}"
                                Padding="8,4" Margin="4,0,0,0" ToolTip="{x:Static p:Strings.OpenFolderTip}"
                                AutomationProperties.AutomationId="main.openFolder"/>
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="{x:Static p:Strings.ToolLabel}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <RadioButton Style="{StaticResource {x:Type ToggleButton}}" GroupName="tool"
                                     Content="{x:Static p:Strings.ToolSelect}" IsChecked="{Binding IsSelectTool}" Padding="8,4"
                                     ToolTip="{x:Static p:Strings.ToolSelectTip}" AutomationProperties.AutomationId="tool.select"/>
                        <RadioButton Style="{StaticResource {x:Type ToggleButton}}" GroupName="tool"
                                     Content="{x:Static p:Strings.ToolRect}" IsChecked="{Binding IsRectTool}" Padding="8,4" Margin="2,0"
                                     ToolTip="{x:Static p:Strings.ToolRectTip}" AutomationProperties.AutomationId="tool.rect"/>
                        <RadioButton Style="{StaticResource {x:Type ToggleButton}}" GroupName="tool"
                                     Content="{x:Static p:Strings.ToolBrush}" IsChecked="{Binding IsBrushTool}" Padding="8,4"
                                     ToolTip="{x:Static p:Strings.ToolBrushTip}" AutomationProperties.AutomationId="tool.brush"/>
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="{x:Static p:Strings.BrushSizeLabel}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <RadioButton Style="{StaticResource {x:Type ToggleButton}}" GroupName="brush"
                                     Content="{x:Static p:Strings.BrushThin}" IsChecked="{Binding IsBrushThin}" Padding="6,4"
                                     AutomationProperties.AutomationId="brush.thin"/>
                        <RadioButton Style="{StaticResource {x:Type ToggleButton}}" GroupName="brush"
                                     Content="{x:Static p:Strings.BrushMedium}" IsChecked="{Binding IsBrushMedium}" Padding="6,4" Margin="2,0"
                                     AutomationProperties.AutomationId="brush.medium"/>
                        <RadioButton Style="{StaticResource {x:Type ToggleButton}}" GroupName="brush"
                                     Content="{x:Static p:Strings.BrushThick}" IsChecked="{Binding IsBrushThick}" Padding="6,4"
                                     AutomationProperties.AutomationId="brush.thick"/>
                    </StackPanel>
                    <StackPanel>
                        <Button Content="{x:Static p:Strings.Undo}" Command="{Binding UndoCommand}" Padding="8,4"
                                ToolTip="{x:Static p:Strings.UndoTip}" AutomationProperties.AutomationId="main.undo"/>
                        <Button Content="{x:Static p:Strings.Redo}" Command="{Binding RedoCommand}" Padding="8,4" Margin="2,0"
                                ToolTip="{x:Static p:Strings.RedoTip}" AutomationProperties.AutomationId="main.redo"/>
                        <Button Content="{x:Static p:Strings.DeleteSelection}" Command="{Binding DeleteSelectionCommand}"
                                Padding="8,4" ToolTip="{x:Static p:Strings.DeleteSelectionTip}" AutomationProperties.AutomationId="main.deleteSelection"/>
                    </StackPanel>
                    <StackPanel>
                        <Button Content="{x:Static p:Strings.RotateLeft}" Command="{Binding RotateLeftCommand}" Padding="8,4"
                                ToolTip="{x:Static p:Strings.RotateLeftTip}" AutomationProperties.AutomationId="main.rotateLeft"/>
                        <Button Content="{x:Static p:Strings.RotateRight}" Command="{Binding RotateRightCommand}" Padding="8,4" Margin="2,0,0,0"
                                ToolTip="{x:Static p:Strings.RotateRightTip}" AutomationProperties.AutomationId="main.rotateRight"/>
                        <Button Content="{x:Static p:Strings.Crop}" Command="{Binding CropCommand}" Padding="8,4" Margin="2,0,0,0"
                                ToolTip="{x:Static p:Strings.CropTip}" AutomationProperties.AutomationId="main.crop"/>
                    </StackPanel>
                    <StackPanel>
                        <Button Content="{x:Static p:Strings.ZoomOut}" Click="OnZoomOut" Padding="8,4" MinWidth="30"
                                ToolTip="{x:Static p:Strings.ZoomTip}" AutomationProperties.AutomationId="main.zoomOut"/>
                        <Button Content="{x:Static p:Strings.ZoomIn}" Click="OnZoomIn" Padding="8,4" MinWidth="30" Margin="2,0"
                                ToolTip="{x:Static p:Strings.ZoomTip}" AutomationProperties.AutomationId="main.zoomIn"/>
                        <Button Content="{x:Static p:Strings.ZoomFit}" Click="OnZoomFit" Padding="8,4"
                                ToolTip="{x:Static p:Strings.ZoomTip}" AutomationProperties.AutomationId="main.zoomFit"/>
                    </StackPanel>
                </WrapPanel>
            </DockPanel>
        </Border>

        <!-- ステータスバー -->
        <Border DockPanel.Dock="Bottom" Background="White" BorderBrush="#DDD" BorderThickness="0,1,0,0" Padding="10,3">
            <TextBlock Text="{Binding StatusMessage}" FontSize="12" Foreground="#444" AutomationProperties.AutomationId="main.status"/>
        </Border>

        <!-- ページレール（左） -->
        <Border DockPanel.Dock="Left" Width="210" Background="White" BorderBrush="#DDD" BorderThickness="0,0,1,0">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="{x:Static p:Strings.PagesHeading}" FontWeight="SemiBold" Margin="10,8,10,4"/>
                <UniformGrid DockPanel.Dock="Bottom" Rows="1" Margin="8">
                    <Button Content="{x:Static p:Strings.MoveUp}" Command="{Binding MovePageUpCommand}" Margin="0,0,2,0" Padding="2,3"
                            AutomationProperties.AutomationId="pages.moveUp"/>
                    <Button Content="{x:Static p:Strings.MoveDown}" Command="{Binding MovePageDownCommand}" Margin="2,0" Padding="2,3"
                            AutomationProperties.AutomationId="pages.moveDown"/>
                    <Button Content="{x:Static p:Strings.RemovePage}" Command="{Binding RemovePageCommand}" Margin="2,0,0,0" Padding="2,3"
                            AutomationProperties.AutomationId="pages.remove"/>
                </UniformGrid>
                <ListBox ItemsSource="{Binding Pages}" SelectedItem="{Binding SelectedPage}" BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch"
                         AutomationProperties.AutomationId="main.pages">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="4,6">
                                <Border Background="#EEE" Height="130">
                                    <Image Source="{Binding Thumbnail}" Stretch="Uniform"/>
                                </Border>
                                <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" FontSize="12" Margin="0,4,0,0"
                                           AutomationProperties.AutomationId="page.title"/>
                                <TextBlock Text="{Binding MaskCountText}" FontSize="11" Foreground="#666"
                                           AutomationProperties.AutomationId="page.maskCount"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- 右ペイン -->
        <Border DockPanel.Dock="Right" Width="320" Background="White" BorderBrush="#DDD" BorderThickness="1,0,0,0">
          <DockPanel>
            <!-- 日本語の文字認識が無い環境の案内（W9-3・閉じられる・書類が無くても出す）。 -->
            <Border DockPanel.Dock="Top" Background="#FFF4E5" BorderBrush="#F0B35A" BorderThickness="0,0,0,1" Padding="10,8"
                    Visibility="{Binding IsOcrUnavailableNoticeVisible, Converter={StaticResource BoolToVis}}"
                    AutomationProperties.AutomationId="side.ocrUnavailableNotice">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="&#xE711;" FontFamily="Segoe MDL2 Assets" Command="{Binding DismissOcrNoticeCommand}"
                            Background="Transparent" BorderThickness="0" Padding="6,2" VerticalAlignment="Top"
                            ToolTip="{x:Static p:Strings.BannerClose}" AutomationProperties.Name="{x:Static p:Strings.BannerClose}"
                            AutomationProperties.AutomationId="side.ocrUnavailableNoticeClose"/>
                    <TextBlock Text="{x:Static p:Strings.OcrUnavailableNotice}" TextWrapping="Wrap" FontSize="12"/>
                </DockPanel>
            </Border>
            <ScrollViewer VerticalScrollBarVisibility="Auto" IsEnabled="{Binding HasPages}">
                <StackPanel Margin="12">
                    <TextBlock Text="{x:Static p:Strings.DocumentTypeLabel}" FontWeight="SemiBold"/>
                    <DockPanel Margin="0,4,0,0">
                        <!-- 自動判定の種類のまま（利用者が選んでいない）なら「自動」 -->
                        <Border DockPanel.Dock="Right" Background="#E0F2FE" CornerRadius="3" Padding="6,1" Margin="6,0,0,0"
                                VerticalAlignment="Center" ToolTip="{x:Static p:Strings.AutoTypeBadgeTip}"
                                Visibility="{Binding IsAutoTypeVisible, Converter={StaticResource BoolToVis}}"
                                AutomationProperties.AutomationId="side.autoTypeBadge"
                                AutomationProperties.Name="{x:Static p:Strings.AutoTypeBadge}">
                            <TextBlock Text="{x:Static p:Strings.AutoTypeBadge}" FontSize="11" Foreground="#075985"/>
                        </Border>
                        <ComboBox ItemsSource="{Binding DocumentTypes}" SelectedItem="{Binding SelectedDocumentType}"
                                  IsEnabled="{Binding IsIdle}"
                                  DisplayMemberPath="DisplayName" AutomationProperties.AutomationId="main.documentType"/>
                    </DockPanel>
                    <TextBlock Text="{x:Static p:Strings.CropHint}" TextWrapping="Wrap" FontSize="12" Foreground="#B45309" Margin="0,6,0,0"
                               Visibility="{Binding IsCropHintVisible, Converter={StaticResource BoolToVis}}"
                               AutomationProperties.AutomationId="side.cropHint"/>
                    <Button Content="{x:Static p:Strings.RereadText}" Command="{Binding RereadTextCommand}" HorizontalAlignment="Left"
                            Padding="10,3" Margin="0,8,0,0" ToolTip="{x:Static p:Strings.RereadTextTip}"
                            ToolTipService.ShowOnDisabled="True" AutomationProperties.AutomationId="side.rereadText"/>

                    <TextBlock Text="{x:Static p:Strings.ChecklistHeading}" FontWeight="SemiBold" Margin="0,16,0,0"/>
                    <TextBlock Text="{x:Static p:Strings.ChecklistNote}" TextWrapping="Wrap" FontSize="11" Foreground="#666" Margin="0,2,0,6"/>
                    <ItemsControl ItemsSource="{Binding Checklist}" AutomationProperties.AutomationId="main.checklist">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="#E5E5E5" BorderThickness="0,0,0,1" Padding="0,6">
                                    <StackPanel>
                                        <CheckBox IsChecked="{Binding IsChecked}"
                                                  Visibility="{Binding HasCheckBox, Converter={StaticResource BoolToVis}}"
                                                  AutomationProperties.AutomationId="checklist.check">
                                            <TextBlock Text="{Binding Label}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                        </CheckBox>
                                        <TextBlock Text="{Binding Label}" FontWeight="SemiBold" TextWrapping="Wrap"
                                                   Visibility="{Binding HasCheckBox, Converter={StaticResource InverseBoolToVis}}"/>
                                        <TextBlock Text="{Binding Note}" TextWrapping="Wrap" FontSize="12" Foreground="#B45309"
                                                   Visibility="{Binding HasCheckBox, Converter={StaticResource InverseBoolToVis}}"/>
                                        <TextBlock Text="{Binding Basis}" TextWrapping="Wrap" FontSize="11" Foreground="#666" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="{x:Static p:Strings.CandidatesHeading}" FontWeight="SemiBold" Margin="0,16,0,4"/>
                    <TextBlock Text="{x:Static p:Strings.CandidatesEmpty}" TextWrapping="Wrap" FontSize="12" Foreground="#666"
                               Visibility="{Binding HasNoCandidates, Converter={StaticResource BoolToVis}}"/>
                    <ItemsControl ItemsSource="{Binding CandidateItems}" AutomationProperties.AutomationId="main.candidates">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding IsOn}" Margin="0,4" ToolTip="{Binding Basis}" AutomationProperties.AutomationId="candidate.toggle">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Label}"/>
                                        <TextBlock Text="{Binding ConfidenceText}" Foreground="#666" Margin="6,0,0,0"/>
                                    </StackPanel>
                                </CheckBox>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
          </DockPanel>
        </Border>

        <!-- 中央: 注意書きバナー＋キャンバス -->
        <DockPanel>
            <Border DockPanel.Dock="Top" Background="#FFF4E5" BorderBrush="#F0B35A" BorderThickness="0,0,0,1" Padding="10,8"
                    Visibility="{Binding IsBannerVisible, Converter={StaticResource BoolToVis}}"
                    AutomationProperties.AutomationId="main.banner">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="&#xE711;" FontFamily="Segoe MDL2 Assets" Command="{Binding DismissBannerCommand}"
                            Background="Transparent" BorderThickness="0" Padding="6,2" VerticalAlignment="Top"
                            ToolTip="{x:Static p:Strings.BannerClose}" AutomationProperties.Name="{x:Static p:Strings.BannerClose}"
                            AutomationProperties.AutomationId="main.bannerClose"/>
                    <TextBlock DockPanel.Dock="Left" Text="&#xE7BA;" FontFamily="Segoe MDL2 Assets" Foreground="#E65100"
                               Margin="0,2,8,0" VerticalAlignment="Top"/>
                    <ItemsControl ItemsSource="{Binding BannerWarnings}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,0,0,2"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </DockPanel>
            </Border>

            <!-- 「1 枚ずつ／一覧」（W9-4）。ページがあるときだけ。 -->
            <Border DockPanel.Dock="Top" Background="White" BorderBrush="#DDD" BorderThickness="0,0,0,1" Padding="10,4"
                    Visibility="{Binding HasPages, Converter={StaticResource BoolToVis}}">
                <StackPanel Orientation="Horizontal" ToolTip="{x:Static p:Strings.ViewTip}">
                    <RadioButton Style="{StaticResource {x:Type ToggleButton}}" GroupName="view"
                                 Content="{x:Static p:Strings.ViewSingle}" IsChecked="{Binding IsSingleView}" Padding="10,3"
                                 AutomationProperties.AutomationId="main.viewSingle"/>
                    <RadioButton Style="{StaticResource {x:Type ToggleButton}}" GroupName="view"
                                 Content="{x:Static p:Strings.ViewGrid}" IsChecked="{Binding IsGridView}" Padding="10,3" Margin="2,0,0,0"
                                 AutomationProperties.AutomationId="main.viewGrid"/>
                </StackPanel>
            </Border>

            <Grid>
                <!-- 一覧（W9-4・確認用の表示だけ。セルを選ぶとそのページの「1 枚ずつ」に戻る）。最大 50 なので仮想化しない。 -->
                <ListBox Panel.ZIndex="1" ItemsSource="{Binding GridCells}" SelectedItem="{Binding SelectedGridCell}"
                         Background="#EDEDED" BorderThickness="0" Padding="8"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         Visibility="{Binding IsGridView, Converter={StaticResource BoolToVis}}"
                         AutomationProperties.AutomationId="main.grid">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Margin" Value="4"/>
                            <Setter Property="Padding" Value="6"/>
                            <Setter Property="Background" Value="White"/>
                            <Setter Property="AutomationProperties.AutomationId" Value="grid.cell"/>
                            <Setter Property="AutomationProperties.Name" Value="{Binding Title}"/>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Width="200">
                                <Border Background="#EEE" Height="150">
                                    <Image Source="{Binding Page.GridThumbnail}" Stretch="Uniform"/>
                                </Border>
                                <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" FontSize="12" Margin="0,4,0,0"
                                           ToolTip="{Binding Title}" AutomationProperties.AutomationId="grid.title"/>
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Right" Text="&#xE7BA;" FontFamily="Segoe MDL2 Assets" Foreground="#E65100"
                                               Margin="4,0,0,0" ToolTip="{Binding WarningsText}" AutomationProperties.Name="{Binding WarningsText}"
                                               Visibility="{Binding HasWarnings, Converter={StaticResource BoolToVis}}"
                                               AutomationProperties.AutomationId="grid.warning"/>
                                    <TextBlock Text="{Binding TypeName}" FontSize="11" Foreground="#666" TextTrimming="CharacterEllipsis"/>
                                </DockPanel>
                                <TextBlock Text="{Binding MaskCountText}" FontSize="11" Foreground="#666"
                                           Visibility="{Binding HasNoMask, Converter={StaticResource InverseBoolToVis}}"
                                           AutomationProperties.AutomationId="grid.maskCount"/>
                                <TextBlock Text="{Binding MaskCountText}" FontSize="12" FontWeight="SemiBold" Foreground="#C62828"
                                           Visibility="{Binding HasNoMask, Converter={StaticResource BoolToVis}}"
                                           AutomationProperties.AutomationId="grid.noMask"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <!-- ビューポート: ここで受けたマウス位置は PageImage 基準に取り直して正規化する。 -->
                <Canvas x:Name="Viewport" ClipToBounds="True" Background="#5A5A5A" Focusable="True"
                        MouseLeftButtonDown="OnViewportMouseDown" MouseMove="OnViewportMouseMove"
                        MouseLeftButtonUp="OnViewportMouseUp" MouseDown="OnViewportOtherMouseDown"
                        MouseUp="OnViewportOtherMouseUp" PreviewMouseWheel="OnViewportMouseWheel"
                        SizeChanged="OnViewportSizeChanged" LostMouseCapture="OnViewportLostCapture">
                    <!-- ズーム/パンはこのコンテナの RenderTransform だけで行う（座標計算には混ぜない）。 -->
                    <Grid x:Name="PageHost">
                        <Grid.RenderTransform>
                            <MatrixTransform x:Name="ViewTransform"/>
                        </Grid.RenderTransform>
                        <Image x:Name="PageImage" Stretch="Fill" RenderOptions.BitmapScalingMode="HighQuality"
                               AutomationProperties.AutomationId="main.pageImage"/>
                        <v:MaskOverlay x:Name="Overlay" IsHitTestVisible="False"/>
                    </Grid>
                </Canvas>
                <!-- 空の画面: 案内＋「作業中の書類」一覧（W5）。一覧以外は当たり判定なし（ドロップはウィンドウで受ける）。 -->
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                              Visibility="{Binding HasPages, Converter={StaticResource InverseBoolToVis}}">
                <StackPanel VerticalAlignment="Center" Margin="24,16">
                    <TextBlock Text="{x:Static p:Strings.EmptyTitle}" FontSize="20" Foreground="White" HorizontalAlignment="Center"
                               IsHitTestVisible="False"/>
                    <TextBlock Text="{x:Static p:Strings.EmptySubtitle}" FontSize="13" Foreground="#DDD" HorizontalAlignment="Center"
                               Margin="0,8,0,0" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="460" IsHitTestVisible="False"/>
                    <Border Background="White" CornerRadius="6" Padding="14,12" Margin="0,24,0,0" MaxWidth="600"
                            Visibility="{Binding IsLibraryVisible, Converter={StaticResource BoolToVis}}"
                            AutomationProperties.AutomationId="library.panel">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Text="{x:Static p:Strings.LibraryHeading}" FontWeight="SemiBold" FontSize="15"/>
                            <TextBlock DockPanel.Dock="Top" Text="{x:Static p:Strings.LibraryStorageNote}" TextWrapping="Wrap"
                                       FontSize="11" Foreground="#555" Margin="0,4,0,8"/>
                            <Button DockPanel.Dock="Bottom" HorizontalAlignment="Right" Margin="0,8,0,0" Padding="10,3"
                                    Content="{x:Static p:Strings.LibraryDeleteAll}" Command="{Binding DeleteAllWorksCommand}"
                                    AutomationProperties.AutomationId="library.deleteAll"/>
                            <ListBox ItemsSource="{Binding LibraryItems}" Height="260" BorderBrush="#DDD"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch"
                                     VirtualizingPanel.IsVirtualizing="True" AutomationProperties.AutomationId="library.list">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <EventSetter Event="MouseDoubleClick" Handler="OnLibraryItemDoubleClick"/>
                                        <Setter Property="Padding" Value="4"/>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="2" ToolTip="{Binding Problem}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="84"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Background="#EEE" Width="76" Height="64" VerticalAlignment="Top">
                                                <Image Source="{Binding Thumbnail}" Stretch="Uniform"/>
                                            </Border>
                                            <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                                           AutomationProperties.AutomationId="library.item.title"/>
                                                <WrapPanel Margin="0,2,0,0">
                                                    <TextBlock Text="{Binding UpdatedText}" FontSize="11" Foreground="#666" Margin="0,0,10,0"/>
                                                    <TextBlock Text="{Binding PageCountText}" FontSize="11" Foreground="#666" Margin="0,0,10,0"
                                                               AutomationProperties.AutomationId="library.item.pageCount"/>
                                                    <TextBlock Text="{Binding StatusText}" FontSize="11" TextWrapping="Wrap" AutomationProperties.AutomationId="library.item.status">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground" Value="#B45309"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsExported}" Value="True">
                                                                        <Setter Property="Foreground" Value="#15803D"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </WrapPanel>
                                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                    <Button Content="{x:Static p:Strings.LibraryOpen}" Command="{Binding OpenCommand}" Padding="12,2"
                                                            Margin="0,0,4,0" ToolTip="{x:Static p:Strings.LibraryOpenTip}"
                                                            Visibility="{Binding IsReadable, Converter={StaticResource BoolToVis}}"
                                                            AutomationProperties.AutomationId="library.item.open"/>
                                                    <Button Content="{x:Static p:Strings.LibraryDelete}" Command="{Binding DeleteCommand}" Padding="12,2"
                                                            AutomationProperties.AutomationId="library.item.delete"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>
                    </Border>
                </StackPanel>
                </ScrollViewer>
            </Grid>
        </DockPanel>
    </DockPanel>
    <!-- 終了時の保存待ち（3 秒を超えたら出す・W6）。 -->
    <Border x:Name="ClosingOverlay" Visibility="Collapsed" Background="#99000000">
