<Project Sdk="Microsoft.NET.Sdk">
  <!-- 取り込み（W2）: ファイル → SourcePage[]。WIC（WPF の System.Windows.Media.Imaging）と PDFium を使う。
       Core に WPF 型を持ち込まないため、別アセンブリにしている（docs/windows-design.md §3.2）。
       通信機能は持たない（生命線）。依存は PDFiumCore（ネイティブ pdfium.dll は bblanchon.PDFium.* が運ぶ）と
       ZXing.Net（QR／バーコード検出・W4。System.Drawing 系のバインディングは入れない）のみ。
       v0.2（W9-2）で TFM を 10.0.17763.0 に上げ、組み込みの WinRT 投影（Microsoft.Windows.SDK.NET・NuGet の追加なし）で
       Windows.Media.Ocr と Windows.Media.FaceAnalysis（どちらも端末内）を呼ぶ（§10.2・§10.13）。 -->
  <PropertyGroup>
    <TargetFramework>net8.0-windows10.0.17763.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <RootNamespace>Fuseo.Input</RootNamespace>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <!-- バージョン固定（win-x64 / win-arm64 の pdfium.dll 入りを確認済み・2026-10-11）。
         更新するときは THIRD-PARTY-NOTICES.txt と内容範囲テストを必ず見直す。 -->
    <PackageReference Include="PDFiumCore" Version="[155.0.8057]" />
    <!-- 2026-10-13 W4 で追加（Apache-2.0）。BGRA 生バッファを RGBLuminanceSource で渡すので描画系パッケージは不要。 -->
    <PackageReference Include="ZXing.Net" Version="[0.16.10]" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Fuseo.Core\Fuseo.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Fuseo.Input.Tests" />
  </ItemGroup>
</Project>
